@model IEnumerable<WatchesStore.Models.Watch>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Admin Dashboard</h1>
            <p class="text-muted">Manage watches</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add New Watch
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Model</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Availability</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var watch in Model)
                {
                    <tr>

                        <td>
                            @if (!string.IsNullOrEmpty(watch.ImageUrl))
                            {
                                <img src="@watch.ImageUrl"
                                     alt="@watch.Model"
                                     style="width:80px;height:80px;object-fit:cover;" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>

                        <td>@watch.Model</td>

                        <td>
                            @(watch.Brand?.BrandName ?? "N/A")
                        </td>

                        <td>
                            @watch.Price.ToString("0.00")
                        </td>

                        <td>
                            @if (watch.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Not Available
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@watch.WatchId"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@watch.WatchId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@watch.WatchId"
                               class="btn btn-success btn-danger">

                            
                                Delete
                            </a>
                            
                            <a asp-action="ChangeAvailability"
                               asp-route-id="@watch.WatchId"
                               class="btn btn-sm btn-secondary">
                                Change Availability
                            </a>
                           

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    </div>

</div>