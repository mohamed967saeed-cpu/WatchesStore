@{
    ViewData["Title"] = "Access Denied";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card auth-card-center">
            <p class="auth-subtitle">403</p>
            <h1>Access Denied</h1>
            <p class="auth-text">
                You don't have permission to view this page.
                This area is reserved for administrators only.
            </p>
            <a asp-controller="Home" asp-action="Index" class="auth-button auth-button-link">
                Back to Home
            </a>
        </div>
    </div>
</section>
