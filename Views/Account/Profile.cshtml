@model WatchesStore.Models.User

@{
    ViewData["Title"] = "My Account";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card auth-card-center">

            <p class="auth-subtitle">MY ACCOUNT</p>
            <h1>@Model.FullName</h1>

            <div class="profile-info">
                <div class="profile-row">
                    <span class="profile-label">Email</span>
                    <span>@Model.Email</span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">Role</span>
                    <span>@Model.Role?.RoleName</span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">Member Since</span>
                    <span>@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>

            @if (Model.Role?.RoleName == "Admin")
            {
                <a asp-controller="Watch" asp-action="Index" class="auth-button auth-button-link">
                    Go to Admin Dashboard
                </a>
            }

            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                <button type="submit" class="auth-button auth-button-outline">Sign Out</button>
            </form>

        </div>
    </div>
</section>
